{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Dixit",
    "mainBinaryName": "Dixit",
    "version": "0.1.0",
    "identifier": "com.vitomanuguerra.trascrivi",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://127.0.0.1:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "Dixit",
                "width": 1100,
                "height": 700,
                "resizable": true,
                "fullscreen": false,
                "decorations": true,
                "backgroundThrottling": "disabled"
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' data:",
                "connect-src": "'self'"
            },
            "capabilities": [
                {
                    "identifier": "main",
                    "description": "Main window capability",
                    "windows": [
                        "main"
                    ],
                    "permissions": [
                        "core:path:default",
                        "core:event:default",
                        "core:window:default",
                        "core:app:default",
                        "core:resources:default",
                        "core:menu:default",
                        "core:tray:default",
                        "core:window:allow-set-title",
                        "store:default",
                        "notification:default",
                        "notification:allow-is-permission-granted",
                        "updater:default",
                        "process:default"
                    ]
                }
            ]
        },
        "withGlobalTauri": true
    },
    "bundle": {
        "active": true,
        "targets": [
            "app",
            "dmg"
        ],
        "createUpdaterArtifacts": true,
        "icon": [
            "icons/icon.png",
            "icons/app_icon.icns",
            "icons/app_icon.ico"
        ],
        "resources": {
            "templates/*.json": "templates/"
        },
        "externalBin": [
            "binaries/llama-helper",
            "binaries/ffmpeg"
        ],
        "macOS": {
            "entitlements": "entitlements.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true,
            "minimumSystemVersion": "14.4"
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzOUJDNDJCMEQyNEYwRDUKUldUVjhDUU5LOFNiNDlFanFIZTlPY3ZuY3pMejB4bS92U3VuV0JXM2k0M01HRzJuRml5N1M2VngK",
            "endpoints": [
                "https://github.com/cannoloops/dixit/releases/latest/download/latest.json"
            ]
        }
    }
}
